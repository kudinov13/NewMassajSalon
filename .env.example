ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=your-smtp-user@yandex.ru
SMTP_PASS=your-smtp-password

# Robokassa
ROBOKASSA_LOGIN=your-merchant-login
ROBOKASSA_PASS1=password1
ROBOKASSA_PASS2=password2
ROBOKASSA_TEST_PASS1=test-password1
ROBOKASSA_TEST_PASS2=test-password2
# 1 — тестовый режим (тестовые карты), 0 — боевой
ROBOKASSA_TEST=1
# Фискальный чек 54-ФЗ через Робокассу: 1 — включить, 0 — выключить
ROBOKASSA_RECEIPT=0
# Система налогообложения для чека: osn, usn_income, usn_income_outcome, envd, esn, patent
ROBOKASSA_SNO=usn_income
# Ставка НДС в чеке: none, vat0, vat10, vat20, vat110, vat120
ROBOKASSA_TAX=none
