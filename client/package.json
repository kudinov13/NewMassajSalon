{
  "name": "todo-list-react-typescript",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@tanstack/react-query": "^4.13.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.11.62",
    "@types/react": "^18.0.21",
    "@types/react-dom": "^18.0.6",
    "final-form": "^4.20.7",
    "hls.js": "^1.7.0",
    "nanoid": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-final-form": "^6.5.9",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^6.4.2",
    "react-scripts": "5.0.1",
    "typescript": "^4.8.4",
    "web-vitals": "^2.1.4",
    "yup": "^0.32.11"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "react-snap --exclude=/panel --exclude=/psychologist --exclude=/bowls-specialist --exclude=/room/:roomId --exclude=/broadcast/:streamId --exclude=/stream/:streamId",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "proxy": "http://localhost:3001",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.12",
    "react-snap": "^1.23.4",
    "tailwindcss": "^3.4.19"
  },
  "reactSnap": {
    "include": [
      "/",
      "/about",
      "/reviews",
      "/shop",
      "/schedule",
      "/tibetan-bowls",
      "/tibetan-bowls/booking",
      "/tibetan-bowls/media",
      "/diagnostics/booking",
      "/diagnostics-schedule",
      "/diagnostics/nails",
      "/diagnostics/tongue",
      "/diagnostics/eyes",
      "/diagnostics/skin",
      "/diagnostics/body",
      "/analyses",
      "/psychology",
      "/psychology/booking",
      "/streams",
      "/courses",
      "/guide",
      "/before-after"
    ],
    "exclude": [
      "/panel",
      "/psychologist",
      "/bowls-specialist",
      "/room/**",
      "/broadcast/**",
      "/stream/**",
      "/login",
      "/registration",
      "/profile",
      "/basket",
      "/my-courses",
      "/purchase-history"
    ],
    "puppeteerArgs": ["--no-sandbox", "--disable-setuid-sandbox"],
    "skipThirdPartyRequests": true,
    "minifyHtml": {
      "collapseWhitespace": true,
      "removeComments": false
    }
  }
}
